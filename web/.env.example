# Copie este archivo como .env (o .env.local) y complete con los datos de su proyecto.
# Supabase: Project Settings > API > Project URL y la llave "anon public".
# La llave anon es pública (va dentro de la página); lo que protege los datos son las políticas RLS.
VITE_SUPABASE_URL=https://SU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Supabase local (npx supabase start, en la carpeta de arriba):
# VITE_SUPABASE_URL=http://127.0.0.1:56321
# VITE_SUPABASE_ANON_KEY=  (ANON_KEY que muestra  npx supabase status)
