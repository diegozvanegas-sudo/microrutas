# Copie este archivo como .env y deje UNA de las dos líneas activa.

# Base local (Docker):
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/microrutas

# Supabase: Dashboard > botón "Connect" > "Session pooler" (funciona con IPv4).
# Si la contraseña tiene símbolos (@ # / ?), escríbalos codificados: @ = %40, # = %23, / = %2F, ? = %3F
# DATABASE_URL=postgresql://postgres.SU_PROYECTO:SU_CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
