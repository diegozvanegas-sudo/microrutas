# Copie este archivo como .env en el servidor y llene los valores. El .env NO se sube a GitHub (el repositorio es público).

# Dominio o subdominio que apunta a la IP del servidor (registro A en el DNS). Ej.: whatsapp.midominio.com
DOMINIO=

# Clave larga y secreta para usar Evolution API (la misma va en Supabase como EVOLUTION_API_KEY).
# Para crear una:  openssl rand -hex 32
AUTHENTICATION_API_KEY=

# Clave de la base de datos interna de Evolution (solo la usa este servidor)
CLAVE_POSTGRES=
